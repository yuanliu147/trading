  },
  "离场计划": {
    "硬止损": "收盘较买入价 -8%，次日开盘卖",
    "b3追踪": "浮盈>=10% 后，从前一日已知峰值回撤 8%，次日开盘卖",
    "死叉": "收盘死叉，次日开盘卖"
  },
  "备注": "通过仅代表候选合格；同一天有多个候选时，选排序分最高者。"
}

