      {"name": "price_limit_pct(code, date, is_st=False, ipo_session=None, delisting=False)", "input": "date ISO; ipo_session 1-based; delisting bool", "output": "float or None (None=无涨跌幅)", "note": "先判IPO前N日/退市首日，再判ST，再判normal"},
      {"name": "limit_prices(prev_close, pct)", "input": "prev_close CNY; pct fraction", "output": "[down, up]", "note": "round half up to 0.01"},
      {"name": "is_limit_up(bar, prev_close, pct)", "input": "bar dict open/high/low/close; prev_close", "output": "bool", "note": "high>=up-0.001 或 close>=up-0.001"},
      {"name": "is_limit_down(...)", "output": "bool"},
      {"name": "is_one_price_board(bar, prev_close, pct)", "output": "bool", "note": "high==low==close且触板"},
      {"name": "min_buy_shares(code)", "output": "int"},
      {"name": "round_lot(shares, code)", "output": "int", "note": "买入向下取整到最小单位；STAR/BSE按1股递增"},
      {"name": "commission(date, amount, side, scenario='conservative')", "output": "float CNY", "note": "max(5, amount*pct)"},
      {"name": "stamp_duty(date, side, amount)", "output": "float"},
      {"name": "transfer_fee(date, board, amount, shares)", "output": "float", "note": "沪市2015前按par_value*shares"},
      {"name": "total_fees(date, board, side, amount, shares, scenario='conservative')", "output": "dict", "note": "commission/stamp/transfer/total"},
      {"name": "dividend_tax_rate(date, holding_days)", "output": "float"},
