{
  "研究范围": "板块趋势/指数趋势/大小周期/跨层联动",
  "总判断": "趋势是层级与尺度相关的现象；更高层共同运动不等于个股买点有效，更不等于所有周期都能赚钱。",
  "核心说明": [
    "层级确实不同：2015—2020个股行业残差20日方差比中位0.950，行业等权1.413，宽基1.196。这只是路径诊断，不是策略收益。",
    "指数与行业时序主成本10bp、最长完整段共910格，其中314格超同暴露为正；统一FDR(q≤0.10)通过0格。价格代理、未含股息/真实ETF追踪成本。",
    "行业轮动最长段主成本格的统一FDR通过0格；官方缓存缺口与完整行业等权合成分别报告，不能跨缺口拼接净值。",
    "大小周期252格：5bp下共振追随超大周期同暴露中位+1.58%，大多小弱-3.70%；统一FDR通过0格。",
    "行业红状态里的20/55日新高，5日扣费后相对留一行业均值范围-0.70%至-0.58%；大周期红不能替个股买点创造边际。",
    "强行业里的弱股相对强股有提示，但只有71个有效月末信号日；分段与流动性控制不构成确认，不能把相对差当买入策略。"
  ],
  "结论表": [
    {
      "问题": "板块趋势",
      "当前答案": "行业等权中短期路径有延续倾向；行业时序及买强/买弱轮动需用完整资金和同集合基准判定，不能把行业涨当个股alpha。"
    },
    {
      "问题": "指数趋势",
      "当前答案": "可作为风险开关的候选；本轮时序主成本910格中FDR通过0格，不能给时间样本外声明。"
    },
    {
      "问题": "大小周期",
      "当前答案": "同向组合整体优于大多小弱，但252格FDR通过0格；用交易日回看尺度，不等于已完成月周K线信号。"
    },
    {
      "问题": "强板块选什么股",
      "当前答案": "行业红状态并不救新高买点；行业内弱股相对更好只是线索，71月末样本日不足。"
    },
    {
      "问题": "证据边界",
      "当前答案": "2010—2020描述性研究；2021以后未评估；价格指数和合成基准非ETF实盘收益。"
    }
  ],
  "限制": [
    "旧轮oracle、空仓超额和A/B验证口径有缺陷，相关强结论已撤回；本轮独立重算，不沿用旧上限数字。",
    "本轮同暴露基准显式计算隔夜和日内仓位漂移及交易再平衡费；置信区间/p改循环移动块，以免端点权重不足。",
    "行业分类2010—2013股票日覆盖约68%—72%，2015后约99.8%以上；早期只有17行业，主行业窗口2015—2020，不能反向回填新行业。",
    "官方行业价格缓存缺若干交易日，严格分段；段末退出只是数据边界截断，不是事前知道缺价的交易策略。完整合成行业作补充但不是可投资产品。",
    "股票日缺失先补日历再差分，缺日后的跨日收益不能充当单日收益；行业成分数和全部均值使用同一有效样本，留一后至少10只。",
    "指数价格未含股息、ETF费率及追踪差；行业与全A等权底层日再平衡费用未计入，不能宣称可部署收益。",
    "所有网格是样本内描述，不从最好的一格倒推未来；多重性校正只覆盖各明确统计族，不能称全球所有工作区试验的校正。",
    "月末双重排序最长71个有效信号日，预设底线100日；统计不足不等于被证伪。相对强股更好不等于绝对收益为正。",
    "这里的大小周期是10—250交易日回看，不是另一次月线/周线已完成K线或分钟级执行研究。"
  ],
  "研究解释": {
    "板块趋势：先分行业共同运动和个股相对运动": "行业等权20/60日方差比中位分别1.413/1.311，个股行业残差约0.950/0.787。同一段里行业可以共同走趋势、个股之间又相对回复，因此不能用个股失败推断行业失败。官方价格指数与等权成分序列权重不同，也不应择优混用。",
    "指数趋势：收益、降暴露与风险保险分开": "按次开交易/完整资金曲线，在所有成本和参数下并列净CAGR、回撤、仓位及两种基准差。主成本最长段FDR通过0格，仍须看分时代和邻域；即使降回撤稳定，也不能自动说有alpha。完整行业合成主成本280格，FDR通过0格。",
    "大小周期：只看方向还不够": "同指数大均线120/250×小均线10/20/60，两种动作各三成本，共252格。同向持有的超大周期同暴露中位为+1.58%，大多小弱为-3.70%。统一FDR通过0格，因此不要把共振当买点保证，也不要把小周期弱机械当便宜。",
    "跨层选股：行业上涨不保证追新高有边际": "在行业前日上行状态下，20/55日新高5日净留一超额范围-0.70%到-0.58%，统一校正后仍为负的格须明确拒绝。强行业弱股减强股约+1.45%到+1.61%，仅71月末日；应继续做未来冻结验证，不能把这变成今日买入列表。"
  },
  "FDR阳性计数口径": "只计净超同暴露或行业基准为正且q≤0.10的格；负向显著不算策略通过",
  "对立假说裁决": {
    "H1_趋势更偏高层级": "中期路径有描述性支持，不能泛称中长期所有尺度有效",
    "H2_全部聚合无可交易趋势": "当前网格未建立稳定盈利证据，不等于证明一切趋势策略不存在",
    "H3_主要提供保险": "须逐指数看回撤与同暴露差，风险开关不能自动冒称alpha",
    "H4_强行业弱股互补": "全窗相对差有线索，只有71月末日，分段与流动性未确认"
  },
