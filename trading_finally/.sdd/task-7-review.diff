+        for day in dates:
+            for code in ("000300.SH", "000852.SH"):
+                index_rows.append({"date": day, "code": code, "close": 1000.0})
+        pd.DataFrame(index_rows).to_parquet(data / "index_panel.parquet", index=False)
+        pd.DataFrame(
+            columns=[
+                "date",
+                "code",
+                "dividend_per_share",
