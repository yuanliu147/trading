+                "stress_rows": result.stress_rows,
+                "conflict_rows": result.conflict_rows,
+                "exclusion_rows": result.exclusion_rows,
+            },
+            ensure_ascii=False,
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
