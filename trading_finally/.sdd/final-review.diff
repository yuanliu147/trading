+        columns = [
+            "date",
+            "code",
+            "dividend_per_share",
+            "per_share_bonus",
+            "rights_ratio",
+            "rights_price",
+        ]
+        actions = pd.DataFrame(rows or [], columns=columns)
+        for column in columns[2:]:
+            actions[column] = pd.to_numeric(actions[column], errors="coerce").fillna(0.0)
+        return actions
