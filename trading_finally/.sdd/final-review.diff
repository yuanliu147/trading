+def load_panel(path: str | Path) -> pd.DataFrame:
+    panel = pd.read_parquet(path)
+    missing = set(PANEL_COLUMNS) - set(panel)
+    if missing:
+        raise ValueError(f"Missing panel columns: {sorted(missing)}")
+    _reject_duplicate_keys(panel)
+    return panel
+
