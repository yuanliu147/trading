+    in_window = main_panel["date"].between(config.start_date, config.end_date)
+    main_window = main_panel.loc[in_window].reset_index(drop=True)
+    baseline_signals_full = _with_previous_ma(compute_signals(main_panel, config), config)
+    baseline_signals = baseline_signals_full.loc[in_window.to_numpy()].reset_index(drop=True)
+    del baseline_signals_full
