+@dataclass(frozen=True)
+class PanelBuildResult:
+    main_panel_path: Path
+    stress_panel_path: Path
+    corporate_actions_path: Path
+    hithink_signal_panel_path: Path
+    index_panel_path: Path
+    audit_path: Path
