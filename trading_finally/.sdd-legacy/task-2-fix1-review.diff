+SQL_PATH = PROJECT_ROOT / "sql" / "legacy_context.sql"
+RAW_PRICE_FIELDS = ("open", "high", "low", "close")
+SIGNAL_FIELDS = tuple(f"signal_{field}" for field in RAW_PRICE_FIELDS)
+CONTEXT_REQUIRED_FIELDS = (
+    *RAW_PRICE_FIELDS,
+    "prev_close",
+    *SIGNAL_FIELDS,
