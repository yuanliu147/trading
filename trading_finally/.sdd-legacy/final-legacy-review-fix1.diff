+
+    candidates_by_name = _candidate_names(data["candidates"])
+    values["candidates"] = tuple(
+        _load_candidate(candidates_by_name[name], name) for name in _CANDIDATE_ORDER
+    )
+    return LegacyResearchConfig(**values)
