+"""Point-in-time signals for frozen legacy candidate A only."""
+
+import numpy as np
+import pandas as pd
+
+from .legacy_data import A_ENTRY_REQUIRED_FIELDS, SIGNAL_FIELDS, candidate_entry_valid
+
+
+KEYS = ["date", "code"]
