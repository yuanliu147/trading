+def _verify_frozen_inputs() -> dict:
+    result = {}
+    for name, expected in FROZEN_INPUT_MANIFEST.items():
+        path = expected["path"]
+        actual = _sha256(path)
+        if actual != expected["sha256"]:
+            raise ValueError(f"Frozen input manifest mismatch: {name}")
+        result[name] = {
+            "path": str(path),
+            "bytes": path.stat().st_size,
+            "sha256": actual,
+        }
+    return result
