+    source = context[[*KEYS, "is_main_board", *SIGNAL_FIELDS, *INDICATOR_COLUMNS]]
+    result = main.merge(
+        source,
+        on=KEYS,
+        how="left",
+        validate="one_to_one",
+        sort=False,
+        indicator=True,
+    )
+    result["context_key_present"] = result["_merge"].eq("both")
+    result = result.drop(columns="_merge").merge(
+        cross_section,
+        on=KEYS,
+        how="left",
+        validate="one_to_one",
+        sort=False,
+    )
