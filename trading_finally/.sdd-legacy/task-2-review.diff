+def _finalize_chunk(
+    chunk: pd.DataFrame,
+    main_conflicts: pd.DataFrame,
+    start_date: str,
+    end_date: str,
+) -> pd.DataFrame:
+    required = {
+        "date",
+        "code",
+        *RAW_PRICE_FIELDS,
+        "prev_close",
+        *SIGNAL_FIELDS,
+        "volume",
+        "amount",
+        "trade_status",
+        "is_st",
+        "ipo_date",
+        "out_date",
+    }
+    missing = required - set(chunk)
+    if missing:
+        raise ValueError(f"Missing full-A columns: {sorted(missing)}")
+    chunk = chunk.copy()
+    chunk["date"] = chunk["date"].astype(str)
+    if chunk.duplicated(["date", "code"]).any():
+        raise ValueError("Duplicate full-A (date, code) key")
+    if not chunk["date"].between(start_date, end_date).all():
+        raise ValueError("Full-A chunk exceeds requested date window")
+    if chunk["code"].str.endswith(".BJ").any():
+        raise ValueError("BJ security entered full-A context")
+    if chunk["ipo_date"].isna().any() or chunk["ipo_date"].eq("").any():
+        raise ValueError("Point-in-time active universe has missing IPO date")
+    if (chunk["ipo_date"] > chunk["date"]).any():
+        raise ValueError("Pre-IPO row entered point-in-time panel")
+    out_date = chunk["out_date"].replace("", pd.NA)
+    chunk["out_date"] = out_date
+    if (out_date.notna() & (out_date <= chunk["date"])).any():
+        raise ValueError("Delisted row entered point-in-time active panel")
+
+    chunk["is_main_board"] = chunk["code"].str[:3].isin(MAIN_BOARD_PREFIXES)
+    chunk = chunk.merge(
+        main_conflicts,
+        on=["date", "code"],
+        how="left",
+        validate="one_to_one",
+    )
+    for column in ("execution_conflict", "adjustment_source_conflict", "source_conflict"):
+        chunk[column] = chunk[column].astype("boolean")
+    for column in ("trade_status", "is_st"):
+        chunk[column] = chunk[column].astype("Int64")
+
+    valid_raw = chunk[[*RAW_PRICE_FIELDS, "prev_close"]].gt(0).all(axis=1)
+    valid_signal = chunk[list(SIGNAL_FIELDS)].gt(0).all(axis=1)
+    chunk["data_valid"] = valid_raw & valid_signal
+    chunk["context_complete"] = (
+        chunk["data_valid"]
+        & _complete_mask(chunk, CONTEXT_REQUIRED_FIELDS)
+        & chunk["volume"].ge(0)
+        & chunk["amount"].ge(0)
+    )
+    columns = [
+        "date",
+        "code",
+        *RAW_PRICE_FIELDS,
+        "prev_close",
+        *SIGNAL_FIELDS,
+        "volume",
+        "amount",
+        "trade_status",
+        "is_st",
+        "ipo_date",
+        "out_date",
+        "is_main_board",
+        "data_valid",
+        "context_complete",
+        "execution_conflict",
+        "adjustment_source_conflict",
+        "source_conflict",
+    ]
+    return chunk[columns].sort_values(["date", "code"]).reset_index(drop=True)
+
