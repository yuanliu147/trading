+def build_legacy_context(config: LegacyResearchConfig) -> LegacyContextResult:
+    """Build full-A and industry panels without writing to either source database."""
+    data_dir = PROJECT_ROOT / "data"
+    results_dir = PROJECT_ROOT / "results"
+    data_dir.mkdir(parents=True, exist_ok=True)
+    results_dir.mkdir(parents=True, exist_ok=True)
+    paths = {
+        "full_a": data_dir / "legacy_full_a_panel.parquet",
+        "industry": data_dir / "legacy_industry_panel.parquet",
+        "audit": results_dir / "legacy_context_audit.json",
+    }
+    temp_path = paths["full_a"].with_suffix(".parquet.tmp")
+    if temp_path.exists():
+        temp_path.unlink()
+
+    databases_before = _verify_database_manifest(config)
+    input_panels = _verify_input_panels()
+    sql_text = SQL_PATH.read_text(encoding="utf-8")
+    main_conflicts = pd.read_parquet(
+        INPUT_PANEL_MANIFEST["main"]["path"],
+        columns=[
+            "date",
+            "code",
+            "execution_conflict",
+            "adjustment_source_conflict",
+            "source_conflict",
+        ],
+    )
+    if main_conflicts.duplicated(["date", "code"]).any():
+        raise ValueError("Duplicate main-panel conflict key")
+    main_conflicts["date"] = main_conflicts["date"].astype(str)
+
+    writer = None
+    full_a_rows = 0
+    codes = set()
+    first_date = None
+    last_date = None
+    performance_dates = set()
+    daily_frames = []
+    a_entry_rows = 0
+    a_entry_complete_rows = 0
+    a_entry_valid_rows = 0
+    conflict_counts = {
+        "execution_conflict_rows": 0,
+        "adjustment_source_conflict_rows": 0,
+        "source_conflict_rows": 0,
+    }
+
+    sqlite = sqlite3.connect(
+        f"{Path(config.baostock_db_path).resolve().as_uri()}?mode=ro", uri=True
+    )
+    duck = duckdb.connect(config.hithink_db_path, read_only=True)
+    try:
+        industry_source = _industry_source_audit(duck, sqlite)
+        for year in range(pd.Timestamp(FULL_A_START_DATE).year, pd.Timestamp(config.end_date).year + 1):
+            chunk_start = max(FULL_A_START_DATE, f"{year}-01-01")
+            chunk_end = min(config.end_date, f"{year}-12-31")
+            raw_chunk = pd.read_sql_query(
+                sql_text, sqlite, params=[chunk_start, chunk_end]
+            )
+            chunk = _finalize_chunk(
+                raw_chunk, main_conflicts, chunk_start, chunk_end
+            )
+            full_a_rows += len(chunk)
+            codes.update(chunk["code"].unique())
+            if len(chunk):
+                first_date = chunk["date"].min() if first_date is None else min(first_date, chunk["date"].min())
+                last_date = chunk["date"].max() if last_date is None else max(last_date, chunk["date"].max())
+            table = pa.Table.from_pandas(chunk, preserve_index=False)
+            if writer is None:
+                writer = pq.ParquetWriter(temp_path, table.schema, compression="snappy")
+            elif table.schema != writer.schema:
+                raise ValueError("Full-A Parquet schema changed between chunks")
+            writer.write_table(table)
+
+            performance = chunk["date"].between(config.start_date, config.end_date)
+            active = chunk.loc[performance, ["date", "code"]]
+            performance_dates.update(active["date"].unique())
+            complete_rows = chunk.loc[
+                performance & chunk["context_complete"], ["date", "code", *CONTEXT_REQUIRED_FIELDS]
+            ]
+            daily_frames.append(
+                daily_coverage(active, complete_rows, CONTEXT_REQUIRED_FIELDS)
+            )
+            entry = chunk.loc[performance & chunk["is_main_board"]]
+            complete = _complete_mask(entry, A_ENTRY_REQUIRED_FIELDS)
+            a_entry_rows += len(entry)
+            a_entry_complete_rows += int(complete.sum())
+            a_entry_valid_rows += int((complete & entry["context_complete"]).sum())
+            for column, key in (
+                ("execution_conflict", "execution_conflict_rows"),
+                ("adjustment_source_conflict", "adjustment_source_conflict_rows"),
+                ("source_conflict", "source_conflict_rows"),
+            ):
+                conflict_counts[key] += int(chunk[column].fillna(False).sum())
+    finally:
+        duck.close()
+        sqlite.close()
+        if writer is not None:
+            writer.close()
+
+    if writer is None:
+        raise ValueError("Full-A query returned no rows")
+    if last_date != config.end_date:
+        raise ValueError("Full-A panel does not reach configured end date")
+
+    full_a_daily = pd.concat(daily_frames, ignore_index=True).sort_values("date")
+    expected_dates = pd.DataFrame({"date": sorted(performance_dates)})
+    index = pd.read_parquet(
+        INPUT_PANEL_MANIFEST["index"]["path"], columns=["date", "code", "close"]
+    )
+    index["date"] = index["date"].astype(str)
+    index = index.loc[
+        (index["code"] == "000001.SH")
+        & index["date"].between(config.start_date, config.end_date)
+    ]
+    if index.duplicated(["date"]).any():
+        raise ValueError("Duplicate Shanghai Composite index date")
+    market = expected_dates.merge(index[["date", "close"]], on="date", how="left")
+    market_coverage = required_field_coverage(market, ("close",))
+    market_valid = bool(len(market) and market["close"].gt(0).all())
+
+    industry = _empty_industry_panel()
+    industry_daily = full_a_daily[["date", "denominator"]].copy()
+    industry_daily["numerator"] = 0
+    industry_daily["coverage"] = 0.0
+    industry_entry_coverage = 0.0
+    a_entry_coverage = (
+        a_entry_complete_rows / a_entry_rows if a_entry_rows else 0.0
+    )
+    a_entry_valid_coverage = (
+        a_entry_valid_rows / a_entry_rows if a_entry_rows else 0.0
+    )
+    gates = {
+        "full_a_point_in_time": coverage_gate_passes(
+            full_a_daily, config.point_in_time_coverage_min
+        ),
+        "a_entry_fields": bool(
+            a_entry_coverage == config.required_entry_coverage
+            and a_entry_valid_coverage == config.required_entry_coverage
+            and market_coverage == config.required_entry_coverage
+            and market_valid
+        ),
+        "industry_point_in_time": bool(
+            industry_source["available"]
+            and industry_source["historical_valid_dates"]
+            and coverage_gate_passes(industry_daily, config.industry_coverage_min)
+        ),
+        "b_entry_fields": bool(
+            industry_entry_coverage == config.required_entry_coverage
+            and not config.candidates[1].not_evaluable_fields
+        ),
+    }
+    statuses = evaluate_candidate_statuses(config, gates)
+
+    databases_after = _verify_database_manifest(config)
+    if databases_after != databases_before:
+        raise ValueError("Source database bytes changed during read-only build")
+    temp_path.replace(paths["full_a"])
+    industry.to_parquet(paths["industry"], index=False)
+
+    audit = {
+        "config": asdict(config),
+        "construction": {
+            "read_only": True,
+            "full_a_start_date": FULL_A_START_DATE,
+            "performance_start_date": config.start_date,
+            "end_date": config.end_date,
+            "full_a_scope": "all type=1 SH/SZ A shares; BJ excluded; current listing status never filters history",
+            "execution_universe": "SH/SZ main-board prefixes only",
+            "active_rule": "ipo_date <= date < out_date; blank out_date remains active",
+            "price_threshold": PRICE_THRESHOLD,
+            "conflict_treatment": "reuse frozen main-panel flags; raw OHLC execution conflicts only; adjustment differences disclosure only",
+            "entry_coverage_denominator": "all active main-board stock-days in the performance window; no candidate signals or entries generated",
+            "sqlite_connection": "URI mode=ro",
+            "duckdb_connection": "read_only=True",
+        },
+        "databases": {
+            "before": databases_before,
+            "after": databases_after,
+            "unchanged": True,
+            "manifest_match": True,
+        },
+        "input_panels": input_panels,
+        "sql": {
+            "path": str(SQL_PATH),
+            "sha256": _sha256(SQL_PATH),
+            "text": sql_text,
+        },
+        "panels": {
+            "full_a": {
+                "path": str(paths["full_a"]),
+                "rows": full_a_rows,
+                "codes": len(codes),
+                "first_date": first_date,
+                "last_date": last_date,
+                "primary_key": ["date", "code"],
+                "performance_dates": len(performance_dates),
+                **conflict_counts,
+            },
+            "industry": {
+                "path": str(paths["industry"]),
+                "rows": len(industry),
+                "first_date": None,
+                "last_date": None,
+                "primary_key": ["code", "valid_from"],
+            },
+        },
+        "coverage": {
+            "full_a": {
+                "threshold": config.point_in_time_coverage_min,
+                "rule": "every day, not pooled",
+                "passes": gates["full_a_point_in_time"],
+                "minimum": float(full_a_daily["coverage"].min()),
+                "days_below_threshold": int(
+                    full_a_daily["coverage"].lt(config.point_in_time_coverage_min).sum()
+                ),
+                "daily": _daily_records(full_a_daily),
+            },
+            "candidate_a_entry": {
+                "required_fields": list(A_ENTRY_REQUIRED_FIELDS),
+                "threshold": config.required_entry_coverage,
+                "denominator": a_entry_rows,
+                "field_complete_numerator": a_entry_complete_rows,
+                "field_coverage": a_entry_coverage,
+                "valid_numerator": a_entry_valid_rows,
+                "valid_coverage": a_entry_valid_coverage,
+                "market_index": "000001.SH",
+                "market_denominator": len(market),
+                "market_field_coverage": market_coverage,
+                "market_valid": market_valid,
+                "passes": gates["a_entry_fields"],
+            },
+            "industry": {
+                "source": industry_source,
