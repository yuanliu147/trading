+def _sha256(path: str | Path) -> str:
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as file:
+        for chunk in iter(lambda: file.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _database_fingerprint(path: str | Path) -> dict:
+    path = Path(path)
+    return {
+        "path": str(path),
+        "bytes": path.stat().st_size,
+        "sha256": _sha256(path),
+    }
+
+
+def _verify_database_manifest(config: LegacyResearchConfig) -> dict:
+    paths = {
+        "hithink": config.hithink_db_path,
+        "baostock": config.baostock_db_path,
+    }
+    fingerprints = {}
+    for name, path in paths.items():
+        expected = DATABASE_MANIFEST[name]
+        actual = _database_fingerprint(path)
+        if (
+            actual["path"] != expected["path"]
+            or actual["bytes"] != expected["bytes"]
+            or actual["sha256"] != expected["sha256"]
+        ):
+            raise ValueError(f"Database manifest mismatch: {name}")
+        fingerprints[name] = actual
+    return fingerprints
+
+
+def _verify_input_panels() -> dict:
+    result = {}
+    for name, expected in INPUT_PANEL_MANIFEST.items():
+        actual = _sha256(expected["path"])
+        if actual != expected["sha256"]:
+            raise ValueError(f"Input panel manifest mismatch: {name}")
+        result[name] = {"path": str(expected["path"]), "sha256": actual}
+    return result
+
