+def _industry_source_audit(duck: duckdb.DuckDBPyConnection, sqlite: sqlite3.Connection) -> dict:
+    duck_columns = duck.execute(
+        """
+        SELECT table_name, column_name
+        FROM duckdb_columns()
+        WHERE database_name = 'market'
+        ORDER BY table_name, column_index
+        """
+    ).fetchall()
+    sqlite_columns = sqlite.execute(
+        """
+        SELECT m.name, p.name
+        FROM sqlite_master AS m
+        JOIN pragma_table_info(m.name) AS p
+        WHERE m.type = 'table'
+        ORDER BY m.name, p.cid
+        """
+    ).fetchall()
+    matches = [
+        {"database": "hithink", "table": table, "column": column}
+        for table, column in duck_columns
+        if "industry" in column.lower() or "sector" in column.lower()
+    ] + [
+        {"database": "baostock", "table": table, "column": column}
+        for table, column in sqlite_columns
+        if "industry" in column.lower() or "sector" in column.lower()
+    ]
+    return {
+        "available": bool(matches),
+        "matching_columns": matches,
+        "historical_valid_dates": False,
+        "current_snapshot_only": False,
+        "hithink_columns_examined": len(duck_columns),
+        "baostock_columns_examined": len(sqlite_columns),
+        "treatment": "no current-snapshot backfill and no fabricated historical membership",
+    }
+
+
+def _daily_records(frame: pd.DataFrame) -> list[dict]:
+    return [
+        {
+            "date": str(row.date),
+            "denominator": int(row.denominator),
+            "numerator": int(row.numerator),
+            "coverage": float(row.coverage),
+        }
+        for row in frame.itertuples(index=False)
+    ]
