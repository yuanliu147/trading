  "sql": {
    "baostock_panel.sql": {
      "path": "/Users/admin/WorkSpace/trading/trading_finally/sql/baostock_panel.sql",
      "sha256": "4e951c0a3aacb0a1c246b6816d2c0a1837f352cb323870217f677a8bd909a40a",
      "text": "SELECT\n    substr(r.code, 4, 6) || '.' || upper(substr(r.code, 1, 2)) AS code,\n    r.date,\n    r.open,\n    r.high,\n    r.low,\n    r.close,\n    r.preclose AS prev_close,\n    h.open AS signal_open,\n    h.high AS signal_high,\n    h.low AS signal_low,\n    h.close AS signal_close,\n    r.volume,\n    r.amount,\n    r.trade_status,\n    r.is_st,\n    b.ipo_date,\n    b.out_date\nFROM stock_kline_d AS r\nJOIN stock_basic AS b ON b.code = r.code\nLEFT JOIN stock_kline_d AS h\n    ON h.code = r.code AND h.date = r.date AND h.adjustflag = 1\nWHERE r.adjustflag = 3\n  AND r.date >= '2010-01-01'\n  AND r.date <= ?\n  AND b.type = 1\n  AND (\n      substr(b.code, 4, 3) IN ('600', '601', '603', '605', '000', '001', '002', '003')\n  )\n  AND (\n      b.code LIKE 'sh.%' OR b.code LIKE 'sz.%'\n  )\n"
    },
    "hithink_overlap.sql": {
      "path": "/Users/admin/WorkSpace/trading/trading_finally/sql/hithink_overlap.sql",
      "sha256": "fb6ff65f4cc781bccaa2d01f23a39ce86a2911b832eadeaf80afad58bc697d5b",
      "text": "SELECT\n    d.thscode AS code,\n    CAST(d.date AS VARCHAR) AS date,\n    d.open AS hithink_open,\n    h.open AS hithink_signal_open,\n    d.high AS hithink_high,\n    h.high AS hithink_signal_high,\n    d.low AS hithink_low,\n    h.low AS hithink_signal_low,\n    d.close AS hithink_close,\n    h.close AS hithink_signal_close,\n    d.volume AS hithink_volume,\n    d.amount AS hithink_amount\nFROM v_daily AS d\nLEFT JOIN v_daily_hfq AS h\n    ON h.thscode = d.thscode AND h.date = d.date\nWHERE d.date >= CAST(? AS DATE)\n  AND d.date <= CAST(? AS DATE)\n  AND (\n      substr(d.thscode, 1, 3) IN ('600', '601', '603', '605', '000', '001', '002', '003')\n  )\n  AND (\n      d.thscode LIKE '%.SH' OR d.thscode LIKE '%.SZ'\n  )\n"
    }
  },
